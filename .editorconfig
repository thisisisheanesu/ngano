# ngano
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.rs]
indent_size = 4
max_line_length = 100

[*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}]
indent_size = 2

[*.{json,jsonc,yml,yaml,toml}]
indent_size = 2

[data/*.json]
# The catalogue is machine generated. Leave trailing whitespace handling to the
# generator so diffs stay meaningful.
trim_trailing_whitespace = false

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf
